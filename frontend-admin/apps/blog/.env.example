# ===========================================
# 博客主站环境变量配置
# ===========================================

# 站点基础 URL
NUXT_PUBLIC_SITE_URL=http://localhost:8081

# API 基础 URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8081/api

# 站点标题
NUXT_PUBLIC_SITE_TITLE=TechBlog

# 站点描述
NUXT_PUBLIC_SITE_DESCRIPTION=一个现代化的技术博客平台

# 站点关键词
NUXT_PUBLIC_SITE_KEYWORDS=技术博客,前端开发,Vue,Nuxt,TypeScript
