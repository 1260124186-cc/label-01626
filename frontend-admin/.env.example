# ===========================================
# 博客系统环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ===========================================

# 应用环境
NODE_ENV=development

# ===========================================
# 博客主站配置 (Nuxt)
# ===========================================

# 站点基础 URL
NUXT_PUBLIC_SITE_URL=http://localhost:8081

# API 基础 URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8081/api

# 站点标题
NUXT_PUBLIC_SITE_TITLE=TechBlog

# 站点描述
NUXT_PUBLIC_SITE_DESCRIPTION=一个现代化的技术博客平台

# ===========================================
# 管理后台配置 (Vite)
# ===========================================

# API 基础 URL
VITE_API_BASE_URL=http://localhost:8081/api

# 应用标题
VITE_APP_TITLE=TechBlog 管理后台

# ===========================================
# 数据库配置 (预留)
# ===========================================

# DATABASE_URL=postgresql://user:password@localhost:5432/blog

# ===========================================
# 认证配置 (预留)
# ===========================================

# JWT 密钥
# JWT_SECRET=your-super-secret-jwt-key

# JWT 过期时间 (秒)
# JWT_EXPIRES_IN=86400

# ===========================================
# 第三方服务配置 (预留)
# ===========================================

# 图片上传服务
# UPLOAD_SERVICE=local
# UPLOAD_MAX_SIZE=5242880

# 邮件服务
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ===========================================
# 分析和监控 (预留)
# ===========================================

# Google Analytics
# GA_TRACKING_ID=

# Sentry DSN
# SENTRY_DSN=
