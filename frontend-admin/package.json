{
  "name": "blog-monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "博客系统 - 包含主站(Nuxt)和管理后台(Vue3+Vite)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:blog": "pnpm --filter @blog/web dev",
    "dev:admin": "pnpm --filter @blog/admin dev",
    "build": "pnpm -r build",
    "build:blog": "pnpm --filter @blog/web build",
    "build:admin": "pnpm --filter @blog/admin build",
    "preview": "pnpm -r --parallel preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r exec rm -rf node_modules dist .nuxt .output && rm -rf node_modules"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.12.1",
    "@nuxt/eslint": "^0.7.4",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-format": "^1.4.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.3"
  }
}
